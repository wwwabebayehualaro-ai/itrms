{
  "name": "@itrms/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system: tokens, themes, primitives, components, page templates and Ethiopian controls",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens": "./src/tokens/index.ts"
  },
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "tokens": "vitest run src/tokens/css.spec.ts -u",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:stories": "node .storybook/run-stories.mjs",
    "test:visual": "playwright test -c visual/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-ethiopic": "5.3.0",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.51.0",
    "next-themes": "0.4.6",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.6.7",
    "react-day-picker": "10.0.2",
    "react-pdf": "11.0.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@itrms/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "next": "16.3.8",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.3"
  }
}
