{
  "components": {
    "schemas": {
      "CreateUnitDto": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "code": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "region",
              "zone",
              "woreda",
              "special_woreda",
              "town_admin",
              "city_admin",
              "sub_city",
              "kebele"
            ],
            "type": "string"
          },
          "levelKey": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "properties": {
              "am": {
                "minLength": 1,
                "type": "string"
              },
              "en": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "am",
              "en"
            ],
            "type": "object"
          },
          "parentId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "unitTypeId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          }
        },
        "required": [
          "parentId",
          "kind",
          "levelKey",
          "code",
          "name"
        ],
        "type": "object"
      },
      "MoveUnitDto": {
        "additionalProperties": false,
        "properties": {
          "parentId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          }
        },
        "required": [
          "parentId"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable snake_case code (api-guidelines.md §4)",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "description": "One entry per refused value",
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "title": {
            "description": "The problem in the person's language",
            "type": "string"
          },
          "traceId": {
            "description": "The request id, to quote to support",
            "type": "string"
          },
          "type": {
            "description": "urn:itrms:problem:<code>",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RenameUnitDto": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "properties": {
              "am": {
                "minLength": 1,
                "type": "string"
              },
              "en": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "am",
              "en"
            ],
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ServiceOverrideDto": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "reason"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Integrated Transport and Road Management System. Errors are application/problem+json (Problem).",
    "title": "ITRMS API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
