// Writes the form_config contract (JSON Schema, from the engine's Zod schemas and the field kit's types) to
// contracts/form-config.schema.json, and the kit's types to src/core/fieldTypes.ts: the API checks every saved form with
// `formConfigSchema(FIELD_TYPES)` and cannot load the kit (it is React).
//
//   pnpm --filter @itrms/form-engine form:schema             write the files
//   pnpm --filter @itrms/form-engine form:schema --check     fail when a committed file is out of date (part of `test`)
import { readFileSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

await import('../src/renderer/fields/registerAll');
const { registeredTypes } = await import('../src/renderer/kit');
const { formConfigJsonSchema } = await import('@itrms/schemas');

const types = [...new Set(registeredTypes())].sort();
const outputs = [
    {
        name: 'contracts/form-config.schema.json',
        path: fileURLToPath(new URL('../../../contracts/form-config.schema.json', import.meta.url)),
        text: formConfigJsonSchema(types)
    },
    {
        name: 'packages/form-engine/src/core/fieldTypes.ts',
        path: fileURLToPath(new URL('../src/core/fieldTypes.ts', import.meta.url)),
        text:
            '// Generated by `pnpm --filter @itrms/form-engine form:schema` from the field kit: do not edit.\n' +
            '/** The field types this engine knows (the API refuses a form with any other). */\n' +
            `export const FIELD_TYPES: readonly string[] = [\n${types.map((t) => `    '${t}'`).join(',\n')}\n];\n`
    }
];

const read = (path: string) => {
    try {
        return readFileSync(path, 'utf8');
    } catch {
        return ''; // new file
    }
};

if (process.argv.includes('--check')) {
    const stale = outputs.filter((o) => read(o.path) !== o.text);
    if (stale.length) {
        for (const o of stale)
            console.error(`${o.name} is out of date: run \`pnpm --filter @itrms/form-engine form:schema\``);
        process.exit(1);
    }
    console.log('form_config contract is current');
} else {
    for (const o of outputs) {
        const changed = read(o.path) !== o.text;
        if (changed) writeFileSync(o.path, o.text);
        console.log(changed ? `wrote ${o.path}` : `${o.name} unchanged`);
    }
}
