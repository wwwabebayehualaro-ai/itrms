{
  "name": "@itrms/form-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Form engine: core (UI-free, also runs in the API), renderer, designer, viewer. The app injects its HTTP client (FormsHost).",
  "exports": {
    "./core": "./src/core/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./designer": "./src/designer/index.ts",
    "./viewer": "./src/viewer/index.ts",
    "./print": "./src/print/index.ts",
    "./print.css": "./src/print/print.css"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && pnpm check:engine && pnpm check:runtime",
    "check:engine": "tsx scripts/checkFormEngineExtensions.mts",
    "check:runtime": "tsx scripts/checkRuntimeEngine.mts",
    "check:roundtrip": "tsx scripts/checkDesignerRoundTrip.mts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@itrms/ethiopian-calendar": "workspace:*",
    "@itrms/schemas": "workspace:*",
    "@itrms/ui": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "8.21.3",
    "date-fns": "4.4.0",
    "immer": "10.2.0",
    "intl-messageformat": "11.2.15",
    "lodash": "4.18.1",
    "lucide-react": "1.51.0",
    "re2js": "2.8.6",
    "recharts": "3.10.1",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@itrms/config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/lodash": "4.17.25",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15"
  }
}
