{
  "name": "@itrms/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, ESLint, Prettier and Vitest presets (code-structure.md §7)",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./prettier": {
      "types": "./prettier.d.ts",
      "default": "./prettier.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    },
    "./vitest/nest": {
      "types": "./vitest-nest.d.ts",
      "default": "./vitest-nest.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.13",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
