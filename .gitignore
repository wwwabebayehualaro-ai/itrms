# ITRMS: repository-wide ignores (apps keep their own .gitignore for tool specifics)

# Environment files: never committed. Only *.example templates are tracked.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies and build/test output
node_modules/
.next/
apps/verify/out/
.next-*/
.turbo/
dist/
coverage/
test-results/
playwright-report/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
.pytest_cache/
uploads/

# Local tool state
.playwright-mcp/
.serena/
.idea/
.vscode/*
!.vscode/extensions.json
*.log
.DS_Store
Thumbs.db

# Domain source material (government documents supplied for analysis). Kept locally, never in the product repository:
# the product's source may be shared with customers, escrow agents and security evaluators.
/Documents/

# Claude Code personal overrides
.claude/settings.local.json

# Office lock files
.~lock.*#

# Workspace build output
.turbo/
dist/
coverage/

# Generated reports
licences-report.md

# Generated by Next.js
next-env.d.ts

# Local Linux CI runs (tools/ci-local.mjs, ADR-0034)
/.ci-local/

# Storybook builds and Playwright output (task 0.4a)
storybook-static/
test-results/
playwright-report/

# the production profile's certificates (tools/prod-stack.mjs; a bureau's own in production)
infra/compose/tls/
# the backups' certificates and keys (tools/prod-stack.mjs, task 0.26b1)
infra/compose/backup-tls/
infra/compose/files-tls/
# the restore drills' reports (counts and digests; the operations log keeps them)
infra/compose/drill-reports/

# the smoke load test's sessions and results (task 0.26c2)
tests/load/.sessions.json
tests/load/summary.json

# the local note of the dev stack's test accounts and passwords (never committed)
/test-accounts*
