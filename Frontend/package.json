        "@types/react-dom": "19.3.0",
        "autoprefixer": "^10.4.21",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.8",
        "happy-dom": "20.14.5",
        "openapi-typescript": "7.13.0",
        "postcss": "^8.5.6",
        "prettier": "3.3.3",
        "shadcn": "4.21.0",
        "tailwindcss": "4.3.3",
        "tsx": "^4.20.3",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3",
        "vite": "7.3.1",
        "vitest": "5.0.3"
