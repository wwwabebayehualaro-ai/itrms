{
    "name": "digital-file-cabinet",
    "version": "10.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "format": "prettier --write \"{app,demo,layout,types}/**/*.{js,ts,tsx,d.ts}\"",
        "lint": "eslint .",
        "check:engine": "tsx scripts/checkFormEngineExtensions.mts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "api:types": "openapi-typescript ../contracts/openapi.json -o platform/lib/api/schema.d.ts",
        "api:check": "openapi-typescript ../contracts/openapi.json -o platform/lib/api/schema.d.ts --check",
        "check:runtime": "tsx scripts/checkRuntimeEngine.mts",
        "form:schema": "tsx scripts/exportFormSchema.mts"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.0.8",
        "@monaco-editor/loader": "^1.5.0",
        "@monaco-editor/react": "^4.7.0",
        "@react-pdf-viewer/core": "^3.12.0",
        "@react-pdf-viewer/default-layout": "^3.12.0",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "^5.81.5",
        "@tanstack/react-table": "^8.21.3",
        "axios": "^1.10.0",
        "class-variance-authority": "0.7.1",
        "cmdk": "1.1.1",
        "cn": "0.4.0",
        "date-fns": "4.4.0",
        "immer": "10.2.0",
        "lodash": "^4.17.21",
        "lucide-react": "1.49.0",
        "next": "16.3.8",
        "next-themes": "0.4.6",
        "pdfjs-dist": "3.11.174",
        "pino": "^9.7.0",
        "pino-pretty": "^13.0.0",
        "radix-ui": "1.6.7",
        "react": "19.3.0",
        "react-day-picker": "10.0.2",
        "react-dom": "19.3.0",
        "recharts": "3.8.0",
        "sonner": "2.0.8",
        "zod": "4.6.5",
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@tailwindcss/postcss": "4.3.3",
        "@tanstack/react-query-devtools": "^5.81.5",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
