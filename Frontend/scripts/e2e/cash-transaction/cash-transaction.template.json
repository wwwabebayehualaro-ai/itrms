{
  "name": "Cash deposit / withdrawal",
  "slug": "cash-transaction",
  "category": "Teller",
  "is_active": true,
  "form_config": {
    "schemaVersion": 2,
    "fields": [
      {
        "id": "account",
        "type": "FormSection",
        "label": "Account",
        "category": "Layout",
        "parentId": null,
        "props": {
          "title": "Account",
          "description": "Type the account number: the account is looked up and its details filled in."
        },
        "layout": {
          "options": {
            "isContainer": true
          }
        }
      },
      {
        "id": "accountNumber",
        "type": "InputText",
        "label": "Account number",
        "category": "Input",
        "parentId": "account",
        "props": {
          "required": true,
          "span": 6,
          "placeholder": "13 digits",
          "helpText": "The customer's 13-digit account number."
        },
        "behavior": {
          "validation": {
            "supported": true,
            "rules": {
              "pattern": "^\\d{13}$",
              "patternMessage": "An account number has 13 digits"
            },
            "remote": {
              "dataSourceId": "accountLookup",
              "message": "This account could not be verified"
            }
          }
        }
      },
      {
        "id": "accountName",
        "type": "InputText",
        "label": "Account holder",
        "category": "Input",
        "parentId": "account",
        "props": {
          "span": 6
        },
        "data": {
          "computed": {
            "expression": "{{data.accountLookup.holder_name | default:\"\"}}",
            "readOnly": true
          }
        },
        "behavior": {
          "validation": {
            "supported": true
          }
        }
      },
      {
        "id": "branch",
        "type": "InputText",
        "label": "Branch",
        "category": "Input",
        "parentId": "account",
        "props": {
          "span": 4
        },
        "data": {
          "computed": {
            "expression": "{{data.accountLookup.branch | default:\"\"}}",
            "readOnly": true
          }
        },
        "behavior": {
          "validation": {
            "supported": true
          }
        }
      },
      {
        "id": "currency",
        "type": "InputText",
        "label": "Currency",
        "category": "Input",
        "parentId": "account",
        "props": {
          "span": 2
        },
        "data": {
          "computed": {
            "expression": "{{data.accountLookup.currency | default:\"\"}}",
            "readOnly": true
          }
        },
        "behavior": {
          "validation": {
            "supported": true
          }
        }
      },
      {
        "id": "accountStatus",
        "type": "InputText",
        "label": "Status",
        "category": "Input",
        "parentId": "account",
        "props": {
          "span": 3
        },
        "data": {
          "computed": {
            "expression": "{{data.accountLookup.status | default:\"\"}}",
            "readOnly": true
          }
        },
        "behavior": {
          "validation": {
            "supported": true,
            "rules": {
              "pattern": "^ACTIVE$",
              "patternMessage": "This account is dormant or blocked: no transactions are possible"
            }
          }
        }
      },
      {
        "id": "availableBalance",
        "type": "InputNumber",
        "label": "Available balance",
        "category": "Input",
        "parentId": "account",
        "props": {
          "span": 3,
          "mode": "decimal",
          "minFractionDigits": 2,
          "maxFractionDigits": 2,
          "useGrouping": true
        },
        "data": {
          "computed": {
            "expression": "{{data.accountLookup.available_balance | default:\"\"}}",
            "readOnly": true
          }
        },
        "behavior": {
          "validation": {
            "supported": true
          }
        }
      },
      {
        "id": "transaction",
        "type": "FormSection",
        "label": "Transaction",
        "category": "Layout",
        "parentId": null,
        "props": {
          "title": "Transaction"
        },
        "layout": {
          "options": {
            "isContainer": true
          }
        }
      },
      {
        "id": "transactionType",
        "type": "RadioButton",
        "label": "Type",
        "category": "Input",
        "parentId": "transaction",
        "props": {
          "required": true,
          "span": 6,
          "value": "deposit",
          "options": [
            {
              "label": "Deposit",
              "value": "deposit"
            },
            {
              "label": "Withdrawal",
              "value": "withdrawal"
            }
          ]
        },
        "behavior": {
          "validation": {
            "supported": true
          }
        }
      },
      {
        "id": "amount",
        "type": "InputNumber",
        "label": "Amount",
        "category": "Input",
        "parentId": "transaction",
        "props": {
          "required": true,
          "span": 6,
          "placeholder": "0.00",
          "mode": "decimal",
          "minFractionDigits": 2,
          "maxFractionDigits": 2,
          "useGrouping": true
        },
        "behavior": {
          "validation": {
            "supported": true,
            "rules": {
              "min": 0.01
            },
            "errorMessages": {
              "min": "Enter an amount above zero"
            }
          },
          "enabledConditions": [
            {
              "field": "data.accountLookup.status",
              "operator": "eq",
              "value": "ACTIVE"
            }
          ]
        }
      },
      {
        "id": "projectedBalance",
        "type": "InputNumber",
        "label": "Balance after this transaction",
        "category": "Input",
        "parentId": "transaction",
        "props": {
          "span": 6,
          "mode": "decimal",
          "minFractionDigits": 2,
          "maxFractionDigits": 2,
          "useGrouping": true,
          "helpText": "Checked again by the system when it posts."
        },
        "data": {
          "computed": {
            "expression": "{{= isEmpty(data.accountLookup) || isEmpty(form.amount) ? \"\" : (form.transactionType == \"withdrawal\" ? data.accountLookup.available_balance - form.amount : data.accountLookup.available_balance + form.amount) }}",
            "readOnly": true
          }
        },
        "behavior": {
          "validation": {
            "supported": true,
            "rules": {
              "min": 0
            },
            "errorMessages": {
              "min": "The withdrawal is more than the available balance"
            }
          }
        }
      },
      {
        "id": "narration",
        "type": "InputTextarea",
        "label": "Narration",
        "category": "Input",
        "parentId": "transaction",
        "props": {
          "required": true,
          "rows": 2,
          "placeholder": "Shown on the customer's statement"
        },
        "behavior": {
          "validation": {
            "supported": true,
            "rules": {
              "maxLength": 140
            }
          }
        }
      },
      {
        "id": "depositorName",
        "type": "InputText",
        "label": "Depositor name",
        "category": "Input",
        "parentId": "transaction",
        "props": {
          "required": true,
          "span": 6,
          "helpText": "Who brings the cash."
        },
        "behavior": {
          "validation": {
            "supported": true,
            "rules": {
              "maxLength": 200
            }
          },
          "visibilityConditions": [
            {
              "field": "transactionType",
              "operator": "eq",
              "value": "deposit"
            }
          ]
        }
      },
      {
        "id": "depositorPhone",
        "type": "InputText",
        "label": "Depositor phone",
        "category": "Input",
        "parentId": "transaction",
        "props": {
          "span": 6,
          "placeholder": "+251 911 000 000"
        },
        "behavior": {
          "validation": {
            "supported": true,
            "rules": {
              "pattern": "^\\+?[0-9 ]{9,18}$",
              "patternMessage": "A phone number has 9 to 15 digits"
            }
          },
          "visibilityConditions": [
            {
              "field": "transactionType",
              "operator": "eq",
              "value": "deposit"
            }
          ]
        }
      },
      {
        "id": "posting",
        "type": "FormSection",
        "label": "Posting",
        "category": "Layout",
        "parentId": null,
        "props": {
          "title": "Posting",
          "description": "Filled in by the system when the transaction is submitted."
        },
        "behavior": {
          "visibilityConditions": [
            {
              "field": "reference",
              "operator": "notEmpty"
            }
          ]
        },
        "layout": {
          "options": {
            "isContainer": true
          }
        }
      },
      {
        "id": "reference",
        "type": "InputText",
        "label": "Reference",
        "category": "Input",
        "parentId": "posting",
        "props": {
          "span": 4,
          "disabled": true
        }
      },
      {
        "id": "postingStatus",
        "type": "InputText",
        "label": "Posting status",
        "category": "Input",
        "parentId": "posting",
        "props": {
          "span": 4,
          "disabled": true
        }
      },
      {
        "id": "balanceAfter",
        "type": "InputNumber",
        "label": "Balance after posting",
        "category": "Input",
        "parentId": "posting",
        "props": {
          "span": 4,
          "disabled": true,
          "mode": "decimal",
          "minFractionDigits": 2,
          "maxFractionDigits": 2,
          "useGrouping": true
        }
      }
    ],
    "runtime": {
      "dataSources": [
        {
          "id": "accountLookup",
          "name": "Account lookup",
          "auth": "app",
          "timeoutMs": 15000,
          "request": {
            "method": "GET",
            "url": "/core-banking/accounts/{acct}",
            "pathParams": {
              "acct": "{{form.accountNumber}}"
            }
          },
          "enabledWhen": [
            {
              "field": "accountNumber",
              "operator": "regex",
              "value": "^\\d{13}$"
            }
          ],
          "cache": {
            "staleTimeMs": 0
          },
          "errorMapping": {
            "statusMessages": {
              "404": "Account not found",
              "403": "You may not look up accounts"
            }
          }
        }
      ],
      "variables": [],
      "submit": {
        "serverAction": "core_banking.cash_transaction",
        "successMessage": "{{response.submission_data.postingStatus}}: {{response.submission_data.reference}}"
      }
    }
  },
  "file_relations": []
}
