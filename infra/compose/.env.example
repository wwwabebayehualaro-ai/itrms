# Keys of the local development stack. `pnpm dev:infra` writes infra/compose/.env with random values on first run.
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_WEB_CLIENT_SECRET=
KEYCLOAK_IDENTITY_ADMIN_SECRET=
BFF_SESSION_KEY=
AUDIT_HMAC_KEY=
CONTEXT_HMAC_KEY=
FIELD_KEK=
BLIND_INDEX_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
# the dev and demo accounts' password (any characters; at least 12, the realm's policy). pnpm dev:infra applies a change.
DEV_USER_PASSWORD=
ITRMS_OWNER_PASSWORD=
ITRMS_APP_PASSWORD=
ITRMS_SYSTEM_PASSWORD=
ITRMS_BACKUP_PASSWORD=

# the second factor (TOTP) at sign-in on this local stack only: on (default) | off, for presenting the demo.
# `pnpm dev:2fa on|off` sets it and applies it; the production profile and CI always require it (SEC-ID-1).
DEV_SECOND_FACTOR=on
