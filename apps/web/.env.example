# Web app (BFF) settings, checked at first use by src/bff/config.ts. In development `pnpm dev:infra` writes them to
# .env.local from infra/compose/.env; this file only names them. Real .env files are never committed.

# The public origin of the staff app (https in production)
APP_ORIGIN=http://localhost:3000
# Where the BFF reaches the API
API_URL=http://127.0.0.1:4000
# The Keycloak realm (https in production)
OIDC_ISSUER=http://localhost:18080/realms/itrms
OIDC_CLIENT_ID=itrms-web
# at least 16 characters
OIDC_CLIENT_SECRET=
# The sessions' Valkey (redis:// or rediss://)
SESSION_VALKEY_URL=redis://localhost:16380
# AES-256-GCM session keys: id:base64key[,id:base64key…], the first one current
SESSION_KEYS=
# Development only: the object store behind /files (Nginx serves /files in production)
FILES_UPSTREAM=http://127.0.0.1:18333
