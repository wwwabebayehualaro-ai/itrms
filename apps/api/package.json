{
  "name": "@itrms/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS 11 on Fastify composition root: the HTTP, worker and migrate processes",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.cjs",
    "start:worker": "node --enable-source-maps dist/worker.cjs",
    "migrate": "node --enable-source-maps dist/migrate.cjs",
    "seed:org": "node --enable-source-maps dist/seed.cjs org",
    "openapi": "nest build && node dist/openapi.cjs",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@itrms/config": "workspace:*",
    "@nestjs/cli": "11.0.9",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "swc-loader": "0.2.7",
    "testcontainers": "12.2.0"
  },
  "dependencies": {
    "@itrms/documents": "workspace:*",
    "@itrms/fees": "workspace:*",
    "@itrms/forms": "workspace:*",
    "@itrms/integrations": "workspace:*",
    "@itrms/kernel": "workspace:*",
    "@itrms/module-sdk": "workspace:*",
    "@itrms/reports": "workspace:*",
    "@itrms/services": "workspace:*",
    "@itrms/workflow": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
