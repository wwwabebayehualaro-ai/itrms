ENV=development                 # development | test | staging | production
# Database (or set DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
# Security - JWT_SECRET is REQUIRED outside development (>= 32 chars, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET=
# :3100 is the Playwright e2e server (npm run e2e)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# Files
UPLOAD_DIR=uploads
# Observability (optional)
LOG_LEVEL=INFO
OTLP_ENDPOINT=
