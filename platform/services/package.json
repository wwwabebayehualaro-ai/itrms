{
  "name": "@itrms/services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Service catalogue, versions and overrides; starts cases with a frozen configuration",
  "exports": {
    "./manifest": "./module.ts",
    "./contracts": "./contracts/index.ts",
    "./api": "./api/index.ts",
    "./api/worker": "./api/worker.ts",
    "./web/server": "./web/server.ts",
    "./web/client": "./web/client.ts",
    "./messages/*": "./messages/*.json",
    "./seed": "./seed/index.ts"
  },
  "imports": {
    "#contracts/*": "./contracts/*.ts",
    "#api/*": "./api/*.ts",
    "#web/*": "./web/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@itrms/form-engine": "workspace:*",
    "@itrms/forms": "workspace:*",
    "@itrms/kernel": "workspace:*",
    "@itrms/module-sdk": "workspace:*",
    "@itrms/schemas": "workspace:*",
    "@itrms/workflow": "workspace:*",
    "@nestjs/common": "11.2.7",
    "drizzle-orm": "0.45.3",
    "nestjs-zod": "5.5.0",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@itrms/config": "workspace:*",
    "@types/node": "24.19.1"
  }
}
