{
  "name": "@itrms/documents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Document templates, PDF rendering, QR signing and verification",
  "exports": {
    "./manifest": "./module.ts",
    "./contracts": "./contracts/index.ts",
    "./api": "./api/index.ts",
    "./api/worker": "./api/worker.ts",
    "./api/pdf-worker": "./api/pdf-worker.ts",
    "./web/server": "./web/server.ts",
    "./web/client": "./web/client.ts",
    "./messages/*": "./messages/*.json",
    "./seed": "./seed/index.ts"
  },
  "imports": {
    "#contracts/*": "./contracts/*.ts",
    "#api/*": "./api/*.ts",
    "#web/*": "./web/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-ethiopic": "5.3.0",
    "@itrms/ethiopian-calendar": "workspace:*",
    "@itrms/fees": "workspace:*",
    "@itrms/forms": "workspace:*",
    "@itrms/kernel": "workspace:*",
    "@itrms/module-sdk": "workspace:*",
    "@itrms/schemas": "workspace:*",
    "@nestjs/common": "11.2.7",
    "drizzle-orm": "0.45.3",
    "liquidjs": "10.30.0",
    "nestjs-zod": "5.5.0",
    "puppeteer-core": "25.15.0",
    "qrcode": "1.5.4",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@itrms/config": "workspace:*",
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.4.299",
    "pngjs": "7.0.0"
  }
}
