{
  "name": "@itrms/kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kernel: config, errors, context, db, iam, org, settings, audit, numbering, idempotency, outbox, jobs, effects, files, i18n, notifications, search, ports, observability and the web runtime",
  "exports": {
    "./manifest": "./module.ts",
    "./contracts": "./contracts/index.ts",
    "./api": "./api/index.ts",
    "./api/worker": "./api/worker.ts",
    "./web/server": "./web/server.ts",
    "./web/client": "./web/client.ts",
    "./messages/*": "./messages/*.json",
    "./seed": "./seed/index.ts",
    "./db": "./api/db/index.ts",
    "./db/system": "./api/db/system.ts"
  },
  "imports": {
    "#contracts/*": "./contracts/*.ts",
    "#api/*": "./api/*.ts",
    "#web/*": "./web/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@itrms/module-sdk": "workspace:*"
  },
  "devDependencies": {
    "@itrms/config": "workspace:*"
  }
}
