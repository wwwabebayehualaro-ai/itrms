{
  "name": "@itrms/kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kernel: config, errors, context, db, iam, org, settings, audit, numbering, idempotency, outbox, jobs, effects, files, i18n, notifications, search, ports, observability and the web runtime",
  "exports": {
    "./manifest": "./module.ts",
    "./contracts": "./contracts/index.ts",
    "./api": "./api/index.ts",
    "./api/worker": "./api/worker.ts",
    "./config": "./api/config/index.ts",
    "./errors": "./api/errors/index.ts",
    "./context": "./api/context/index.ts",
    "./web/server": "./web/server.ts",
    "./web/client": "./web/client.ts",
    "./messages/*": "./messages/*.json",
    "./seed": "./seed/index.ts",
    "./db": "./api/db/index.ts",
    "./db/system": "./api/db/system.ts",
    "./iam": "./api/iam/index.ts",
    "./org": "./api/org/index.ts",
    "./numbering": "./api/numbering/index.ts",
    "./outbox": "./api/outbox/index.ts",
    "./testing": "./api/testing/index.ts",
    "./crypto": "./api/crypto/index.ts",
    "./tables": "./api/tables/index.ts",
    "./files": "./api/files/index.ts",
    "./effects": "./api/effects/index.ts",
    "./notifications": "./api/notifications/index.ts"
  },
  "imports": {
    "#contracts/*": "./contracts/*.ts",
    "#api/*": "./api/*.ts",
    "#web/*": "./web/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@itrms/ethiopian-calendar": "workspace:*",
    "@itrms/module-sdk": "workspace:*",
    "@itrms/schemas": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@itrms/config": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1"
  }
}
