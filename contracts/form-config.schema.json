              "Calendar",
              "Card",
              "Checkbox",
              "CheckboxGroup",
              "Chips",
              "ColorPicker",
              "DataTable",
              "Divider",
              "Dropdown",
              "Fieldset",
              "FileUpload",
              "FormArray",
              "FormSection",
              "InputMask",
              "InputNumber",
              "InputSwitch",
              "InputText",
              "InputTextarea",
              "MultiSelect",
              "Panel",
              "Password",
              "RadioButton",
              "Rating",
              "Slider"
            ]
          },
          "category": {
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "parentId": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "props": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "defaultProps": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "dataSource": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "staticData": {}
                        },
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "optionsBinding": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "dataSourceId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "dataSourceId"
                        ],
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rowsBinding": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "dataSourceId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "dataSourceId"
                        ],
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "computed": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "expression": {
                            "type": "string"
                          },
                          "readOnly": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "expression"
                        ],
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "behavior": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "validation": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "supported": {
                            "type": "boolean"
                          },
                          "types": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "rules": {
                            "anyOf": [
                              {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {}
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "errorMessages": {
                            "anyOf": [
                              {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {}
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "remote": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "dataSourceId": {
                                    "type": "string"
                                  },
                                  "message": {}
                                },
                                "required": [
                                  "dataSourceId"
                                ],
                                "additionalProperties": {}
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "visibilityConditions": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/__schema0"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "enabledConditions": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/__schema0"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "actions": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
