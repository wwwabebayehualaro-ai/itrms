          "type"
        ],
        "additionalProperties": {}
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "dataSources": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "request": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "method",
                  "url"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "request"
            ],
            "additionalProperties": {}
          }
        },
        "submit": {
          "type": "object",
          "properties": {
            "serverAction": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "dataSources"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "fields"
  ],
  "additionalProperties": {},
  "title": "form_config",
  "description": "A stored form: its fields (flat, linked by parentId) and its runtime (data sources, variables, submit).",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "field": {
          "default": "",
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "value": {},
        "logic": {
          "type": "string",
          "enum": [
            "and",
            "or",
            "xor"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "clientOnly": {
          "type": "boolean"
        },
        "serverOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "operator"
      ],
      "additionalProperties": {}
    }
  }
