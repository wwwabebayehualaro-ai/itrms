{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests", "group:monorepos"],
  "timezone": "Africa/Addis_Ababa",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "14 days",
  "rangeStrategy": "pin",
  "labels": ["dependencies"],
  "ignorePaths": ["Backend/**", "tools/boundaries/fixtures/**"],
  "packageRules": [
    {
      "description": "Lint, format, type and test tooling move together",
      "groupName": "dev tooling",
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "globals",
        "prettier",
        "typescript",
        "vitest",
        "dependency-cruiser",
        "lefthook",
        "turbo",
        "@turbo/gen"
      ]
    },
    {
      "description": "Node.js and pnpm follow the LTS line and the pinned packageManager (tech-stack T24)",
      "groupName": "toolchain",
      "matchPackageNames": ["node", "pnpm", "@types/node"]
    },
    {
      "description": "pdfjs-dist must match the version react-pdf is built against (its worker is bundled from pdfjs-dist)",
      "groupName": "pdf viewer",
      "matchPackageNames": ["react-pdf", "pdfjs-dist"]
    },
    {
      "description": "CI actions and scanner images",
      "groupName": "ci",
      "matchManagers": ["github-actions", "custom.regex"]
    },
    {
      "description": "The Playwright image and packages must have the same version (its browsers are built for it); after this rule so it wins over the ci group",
      "groupName": "playwright",
      "matchPackageNames": ["playwright", "@playwright/test", "mcr.microsoft.com/playwright"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Scanner images pinned by tag and digest in the CI workflow",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>zricethezav/gitleaks|semgrep/semgrep):(?<currentValue>v?\\d+\\.\\d+\\.\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The Playwright image of the stories job, pinned by tag and digest (moves with @playwright/test)",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>mcr\\.microsoft\\.com/playwright):v(?<currentValue>\\d+\\.\\d+\\.\\d+)-noble@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{depName}}:v{{newValue}}-noble@{{newDigest}}"
    },
    {
      "customType": "regex",
      "description": "The Trivy image pinned by tag and digest in the local Linux CI (ADR-0034)",
      "managerFilePatterns": ["/^tools/ci-local\\.mjs$/"],
      "matchStrings": [
        "(?<depName>aquasec/trivy):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
